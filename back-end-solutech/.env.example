# Copier vers .env et renseigner les valeurs. Ne jamais committer .env.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Base de données PostgreSQL (optionnel : SQLite par défaut)
# POSTGRES_DB=solutech
# POSTGRES_USER=solutech
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Scripts d'administration / seed (jamais de valeurs par défaut en clair)
SOLUTECH_API_URL=http://127.0.0.1:8000
SOLUTECH_ADMIN_USERNAME=
SOLUTECH_ADMIN_PASSWORD=
SOLUTECH_SEED_TEACHER_PASSWORD=
SOLUTECH_SEED_PARENT_PASSWORD=
